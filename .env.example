# Auto-generated .env example — social-media-pipeline
# keybox로 생성: .\.keybox\bootstrap-env.ps1 -Project iflo -OutDir C:\...\social-media-pipeline
# ⚠️  이 파일을 git commit 하지 마세요

# ── OpenAI (keybox: "OpenAI API Key") ────────────────────────
IFLO_OPENAI_API_KEY=

# ── Supabase (keybox: "IFLO Supabase") ───────────────────────
IFLO_SUPABASE_URL=
IFLO_SUPABASE_KEY=

# ── Cloudflare R2 (keybox: "Cloudflare R2") ──────────────────
IFLO_R2_ACCOUNT_ID=
IFLO_R2_ACCESS_KEY_ID=
IFLO_R2_SECRET_ACCESS_KEY=
IFLO_R2_BUCKET_NAME=social-media-assets
IFLO_R2_PUBLIC_URL=

# ── Buffer (keybox: "Buffer API Key", "Buffer Profile IDs") ──
IFLO_BUFFER_API_KEY=
IFLO_BUFFER_CHANNEL_ID=
IFLO_BUFFER_PROFILE_X=
IFLO_BUFFER_PROFILE_LINKEDIN=
IFLO_BUFFER_PROFILE_INSTAGRAM=
IFLO_BUFFER_PROFILE_FACEBOOK=

# ── TikTok (keybox: "TikTok Access Token", "TikTok Developer App") ──
IFLO_TIKTOK_ACCESS_TOKEN=
IFLO_TIKTOK_CLIENT_KEY=
IFLO_TIKTOK_CLIENT_SECRET=

# ── 선택 ──────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
PIPELINE_CRON_INTERVAL_HOURS=1
PIPELINE_MAX_ARTICLES_PER_RUN=5
